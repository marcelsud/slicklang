// Exact-name imports expose only the public surface of each namespace.
use root.bank.adapters.NewFixedAccountSource
use root.bank.application.Deposit
use root.bank.domain.OpenAccount
use root.models.NewUser

function main() -> string throws root.bank.domain.InvalidAmount {
    let User = NewUser("Ada")
    let Account = OpenAccount("account-123", "Ada", 1000)
    let Source = NewFixedAccountSource(Account)
    let Updated = Deposit(Source, 500)
    let UserDescription = User.Describe()
    let Owner = Updated.Owner()
    let Balance = Updated.Balance()
    `${UserDescription}; ${Owner}: ${Balance} cents`
}
