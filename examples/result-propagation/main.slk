// Forwarding failures with `?`
// ============================
//
// Postfix `?` unwraps a Result inside a function that itself returns a Result.
//
//   on Ok(value)   the expression evaluates to value
//   on Err(error)  the enclosing function immediately returns that same Err
//
// This keeps the success path flat: each step reads as a plain assignment
// instead of a nested match per call.
//
// Rules the compiler enforces:
//
//   * the operand must be a Result (SLK352)
//   * the enclosing function must return a Result (SLK353)
//   * the operand's error type must match the enclosing error type exactly,
//     with no implicit conversion (SLK354)
//   * the operand is evaluated exactly once
//
// `?` is not `throw`. The Err leaves as an ordinary return value, so it does
// not enter the `throws` effect system and no `catch` can observe it.
//
// Prints: localhost:8080; empty host; 6; zero is not scorable

class LoadError implements Error {
    Message: string
}

function read_host(Raw: string) -> Result<string, LoadError> {
    if (Raw == "") { Err(LoadError { Message: "empty host" }) } else { Ok(Raw) }
}

function read_port(Raw: int) -> Result<int, LoadError> {
    if (Raw == 0) { Err(LoadError { Message: "missing port" }) } else { Ok(Raw) }
}

class Config {
    Host: string
    Port: int
    function Endpoint() -> Result<string, LoadError>
}

// Two fallible steps, no nesting. `Host` is a string and `Port` is an int --
// `?` has already removed the Result wrapper. If read_host fails, read_port is
// never called and the LoadError is returned from Endpoint unchanged.
//
// `?` works the same in a method as in a free function.
function Config.Endpoint() -> Result<string, LoadError> {
    let Host = read_host(self.Host)?
    let Port = read_port(self.Port)?
    Ok(`${Host}:${Port}`)
}

function score(Value: int) -> Result<int, LoadError> {
    if (Value == 0) { Err(LoadError { Message: "zero is not scorable" }) } else { Ok(Value) }
}

// `?` short-circuits out of a loop too: the first Err returns from `total`
// without running the remaining iterations.
function total(Values: int[]) -> Result<int, LoadError> {
    let Sum = 0
    for Value in Values {
        let Points = score(Value)?
        Sum = Sum + Points
    }
    Ok(Sum)
}

function main() -> string {
    let Good = Config { Host: "localhost", Port: 8080 }
    let Blank = Config { Host: "", Port: 8080 }
    let Ready = match Good.Endpoint() { Ok(Text) => Text Err(Problem) => Problem.Message }
    let Broken = match Blank.Endpoint() { Ok(Text) => Text Err(Problem) => Problem.Message }
    let Summed = match total([1, 2, 3]) { Ok(Sum) => `${Sum}` Err(Problem) => Problem.Message }
    let Stopped = match total([1, 0, 3]) { Ok(Sum) => `${Sum}` Err(Problem) => Problem.Message }
    `${Ready}; ${Broken}; ${Summed}; ${Stopped}`
}
