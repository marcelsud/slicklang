function Must<T>(Value: Result<T, std.sqlite.Failure>) -> T throws std.sqlite.Failure {
    match Value {
        Ok(Payload) => Payload
        Err(Failure) => Abort<T>(Failure)
    }
}

function Abort<T>(Failure: std.sqlite.Failure) -> T throws std.sqlite.Failure {
    throw Failure
}

function ExtractTitle(Row: std.sqlite.Row) -> string {
    let Vals = Row.Values
    let Val = Vals.Get("title")
    if (Val == null) {
        "missing"
    } else {
        match Val {
            std.sqlite.Value.Text(T) => T
            _ => "wrong-type"
        }
    }
}

function Exercise() -> string throws std.sqlite.Failure {
    using DB = Must<std.sqlite.Database>(std.sqlite.Open(":memory:")) {
        let CreateStmt = std.sqlite.Statement {
            SQL: "CREATE TABLE todos (id INTEGER PRIMARY KEY, title TEXT)"
            Parameters: []
        }
        Must<std.sqlite.Execution>(DB.Execute(CreateStmt))

        let InsertStmt = std.sqlite.Statement {
            SQL: "INSERT INTO todos (id, title) VALUES (?, ?)"
            Parameters: [std.sqlite.Value.Integer(1), std.sqlite.Value.Text("ship sqlite")]
        }
        Must<std.sqlite.Execution>(DB.Execute(InsertStmt))

        let Query = std.sqlite.Query {
            SQL: "SELECT title FROM todos WHERE id = 1"
            Parameters: []
            MaxRows: 10
            MaxBytes: 1024
        }
        let Rows = Must<std.sqlite.Row[]>(DB.Query(Query))
        let First = Rows.Get(0)
        if (First == null) {
            "none"
        } else {
            let Title = ExtractTitle(First)
            `todo: ${Title}`
        }
    }
}

function main() -> string throws std.sqlite.Failure {
    Exercise()
}
