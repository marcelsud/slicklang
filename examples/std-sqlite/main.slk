function ExtractTitle(Row: std.sqlite.Row) -> string {
    let Vals = Row.Values
    let Val = Vals.Get("title")
    if (Val == null) {
        "missing"
    } else {
        match Val {
            std.sqlite.Value.Text(T) => T
            _ => "wrong-type"
        }
    }
}

function Exercise() -> Result<string, std.sqlite.Failure> throws std.sqlite.Failure {
    using DB = std.sqlite.Open(":memory:")? {
        let CreateStmt = std.sqlite.Statement {
            SQL: "CREATE TABLE todos (id INTEGER PRIMARY KEY, title TEXT)"
            Parameters: []
        }
        DB.Execute(CreateStmt)?

        let InsertStmt = std.sqlite.Statement {
            SQL: "INSERT INTO todos (id, title) VALUES (?, ?)"
            Parameters: [std.sqlite.Value.Integer(1), std.sqlite.Value.Text("ship sqlite")]
        }
        DB.Execute(InsertStmt)?

        let Query = std.sqlite.Query {
            SQL: "SELECT title FROM todos WHERE id = 1"
            Parameters: []
            MaxRows: 10
            MaxBytes: 1024
        }
        let Rows = DB.Query(Query)?
        let First = Rows.Get(0)
        if (First == null) {
            Ok("none")
        } else {
            Ok(ExtractTitle(First))
        }
    }
}

function main() -> string throws std.sqlite.Failure {
    match Exercise() {
        Ok(Title) => `todo: ${Title}`
        Err(Failure) => Failure.Message
    }
}
