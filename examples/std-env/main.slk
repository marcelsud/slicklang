function ValueOr(Value: string?, Fallback: string) -> string {
    if (Value == null) {
        Fallback
    } else {
        Value
    }
}

function Exercise(Name: string) -> Result<string, std.env.Failure> effects { environment } {
    std.env.Unset(Name)?
    let Before = ValueOr(std.env.Get(Name), "missing")
    std.env.Set(Name, "Ada")?
    let During = ValueOr(std.env.Get(Name), "missing")
    std.env.Unset(Name)?
    let After = ValueOr(std.env.Get(Name), "missing")
    Ok(`${Before};${During};${After}`)
}

function main() -> string effects { environment } {
    match Exercise("SLICK_STDLIB_ENV_EXAMPLE") {
        Ok(Output) => Output
        Err(Failure) => Failure.Message
    }
}
